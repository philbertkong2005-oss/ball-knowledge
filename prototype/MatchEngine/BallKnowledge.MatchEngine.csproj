<Project Sdk="Microsoft.NET.Sdk">

  <!-- Multi-target: net8.0 for the Phase 1 console/tests (unchanged), netstandard2.1 so the
       SAME engine can ship as a managed DLL into Unity (Phase 2 bridge). Packaging change only;
       public API, behaviour, and Gate-1 outputs stay frozen (verified by re-running the Phase 1 proof). -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BallKnowledge.Tests" />
  </ItemGroup>

  <!-- netstandard2.1 lacks BCL pieces the engine relies on (init/required members, and the inert
       [JsonPropertyName] attribute). These are supplied as compile-time shims in
       NetstandardCompat.cs rather than by referencing the real System.Text.Json package: the
       engine never calls JsonSerializer, so a package reference buys nothing while dragging 8
       transitive DLLs into Unity's Plugins/ (duplicate-assembly conflicts + IL2CPP stripping
       risk). Result: the Unity DLL has ZERO external dependencies. net8.0 is untouched and binds
       the real BCL types. Packaging plumbing only — no engine logic, no public API. -->

</Project>
